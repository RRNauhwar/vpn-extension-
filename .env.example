# =============================================================================
# GlobeVPN Environment Configuration (Example)
# Copy to .env and replace all placeholder secrets before running in production.
# NEVER commit real .env files or private keys to version control.
# =============================================================================

# Brand & App
APP_NAME=GlobeVPN
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api

# Security & JWT
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_64_CHAR_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
ADMIN_API_KEY=CHANGE_ME_ADMIN_PROVISIONING_KEY

# Database (PostgreSQL in production/Docker, SQLite fallback for local unit tests)
DATABASE_URL=postgresql+psycopg://globevpn:globevpn_dev_pass@postgres:5432/globevpn

# Redis (Rate limiting, ephemeral session credentials, health cache)
REDIS_URL=redis://redis:6379/0

# CORS (Restrict to your Chrome Extension ID in production: chrome-extension://<id>)
CORS_ORIGINS=chrome-extension://*,http://localhost:5173,http://localhost:8000

# Free-Tier Fair Use & Rate Limiting
FREE_TIER_MAX_SESSION_MINUTES=120
FREE_TIER_MAX_DAILY_SESSIONS=20
FREE_TIER_RATE_LIMIT_PER_MINUTE=60
PRO_TIER_MAX_SESSION_MINUTES=1440
PRO_TIER_RATE_LIMIT_PER_MINUTE=240

# Proxy Session Credential TTL (seconds)
PROXY_SESSION_TTL_SECONDS=7200

# Health Monitor
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=5

# Local Development Docker Proxy Node (Real authenticated proxy for local testing)
LOCAL_PROXY_ENABLED=true
LOCAL_PROXY_HOST=127.0.0.1
LOCAL_PROXY_PORT=8443
LOCAL_PROXY_SCHEME=http
LOCAL_PROXY_AUTH_USER=globevpn_local
LOCAL_PROXY_AUTH_PASS=CHANGE_ME_LOCAL_PROXY_PASS
LOCAL_PROXY_COUNTRY_CODE=LOCAL
LOCAL_PROXY_COUNTRY_NAME=Local Docker Node
LOCAL_PROXY_CITY=Localhost
